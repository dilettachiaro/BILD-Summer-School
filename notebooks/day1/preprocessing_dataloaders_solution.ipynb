# --- FIX NIH METADATA DATAFRAME COLUMNS ---

import pandas as pd

# Load the metadata
print("Loading metadata...")
metadata_df = pd.read_csv('/content/data/CXR8/Data_Entry_2017.csv')

print("Original columns:")
print(metadata_df.columns.tolist())
print(f"Shape: {metadata_df.shape}")

# Remove the unnamed column (which is all NaN)
print("\nRemoving unnamed column...")
metadata_df = metadata_df.drop('Unnamed: 11', axis=1)

# Fix the column names to match the original format
print("\nFixing column names...")
column_mapping = {
    'Image Index': 'Image Index',
    'Finding Labels': 'Finding Labels', 
    'Follow-up #': 'Follow-up #',
    'Patient ID': 'Patient ID',
    'Patient Age': 'Patient Age',
    'Patient Gender': 'Patient Sex',  # This is the key change
    'View Position': 'View Position',
    'OriginalImage[Width': 'OriginalImage[Width',
    'Height]': 'Height]',
    'OriginalImagePixelSpacing[x': 'OriginalImagePixelSpacing[x',
    'y]': 'y]'
}

# Apply the column mapping
metadata_df = metadata_df.rename(columns=column_mapping)

print("Fixed columns:")
print(metadata_df.columns.tolist())
print(f"New shape: {metadata_df.shape}")

# Verify the changes
print(f"\nDataFrame info:")
print(f"- Total rows: {len(metadata_df)}")
print(f"- Columns: {len(metadata_df.columns)}")
print(f"- Key change: 'Patient Gender' → 'Patient Sex'")
print(f"- Unnamed column removed: ✅")

# Show first few rows to verify
print(f"\nFirst 3 rows:")
print(metadata_df.head(3))

# Check for any remaining issues
print(f"\nChecking for remaining issues:")
print(f"- Any unnamed columns: {any('Unnamed' in col for col in metadata_df.columns)}")
print(f"- Any NaN columns: {metadata_df.isnull().all().sum()}")

# Save the cleaned metadata (optional)
print(f"\nSaving cleaned metadata...")
metadata_df.to_csv('/content/data/CXR8/Data_Entry_2017_cleaned.csv', index=False)
print("✅ Cleaned metadata saved as 'Data_Entry_2017_cleaned.csv'")

print(f"\n=== FINAL RESULT ===")
print("Your columns now match the original notebook format:")
print(metadata_df.columns.tolist())
